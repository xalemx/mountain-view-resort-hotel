{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "description": "Short reference shown to the guest, for example MV-7KQ2XA"
    },
    "guest_name": {
      "type": "string",
      "description": "Name of the guest sending the request"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "reply_method": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email"
      ],
      "default": "email",
      "description": "How the guest asked to be answered"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "me",
        "ru",
        "sq"
      ],
      "default": "en",
      "description": "Language the guest used on the website"
    },
    "property": {
      "type": "string",
      "enum": [
        "mountain_view_resort",
        "mountain_view_inn",
        "either"
      ],
      "default": "mountain_view_resort"
    },
    "arrival": {
      "type": "string",
      "format": "date"
    },
    "departure": {
      "type": "string",
      "format": "date"
    },
    "adults": {
      "type": "number",
      "default": 2
    },
    "children": {
      "type": "number",
      "default": 0
    },
    "children_ages": {
      "type": "string",
      "description": "Ages of the children, as the guest entered them, for example 6, 9"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "offer_sent",
        "confirmed",
        "closed"
      ],
      "default": "new",
      "description": "New, Offer sent, Confirmed or Closed. Only the owner changes this."
    },
    "owner_notes": {
      "type": "string",
      "description": "Private notes the owner keeps about this enquiry; never shown to the guest"
    },
    "notification_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "default": "pending",
      "description": "Host alert state: pending, accepted for delivery (sent) or failed"
    },
    "notification_attempts": {
      "type": "number",
      "default": 0,
      "description": "How many times the host alert has been attempted"
    },
    "notification_recipient": {
      "type": "string",
      "description": "Address the host alert was sent to"
    },
    "notification_error": {
      "type": "string",
      "description": "Why the last host alert attempt failed"
    },
    "notified_at": {
      "type": "string",
      "description": "When the mail service accepted the host alert"
    }
  },
  "required": [
    "guest_name",
    "arrival",
    "departure"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}