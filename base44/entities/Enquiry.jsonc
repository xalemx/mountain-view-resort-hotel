{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "description": "Short reference shown to the guest, for example MV-7KQ2XA"
    },
    "guest_name": {
      "type": "string",
      "description": "Name of the guest sending the request"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "reply_method": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email"
      ],
      "default": "email",
      "description": "How the guest asked to be answered"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "me",
        "ru",
        "sq"
      ],
      "default": "en",
      "description": "Language the guest used on the website"
    },
    "property": {
      "type": "string",
      "enum": [
        "mountain_view_resort",
        "mountain_view_inn",
        "either"
      ],
      "default": "mountain_view_resort"
    },
    "arrival": {
      "type": "string",
      "format": "date"
    },
    "departure": {
      "type": "string",
      "format": "date"
    },
    "adults": {
      "type": "number",
      "default": 2
    },
    "children": {
      "type": "number",
      "default": 0
    },
    "children_ages": {
      "type": "string",
      "description": "Ages of the children, as the guest entered them, for example 6, 9"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "offer_sent",
        "confirmed",
        "closed"
      ],
      "default": "new",
      "description": "New, Offer sent, Confirmed or Closed. Only the owner changes this."
    },
    "owner_notes": {
      "type": "string",
      "description": "Private notes the owner keeps about this enquiry; never shown to the guest"
    },
    "notification_status": {
      "type": "string",
      "enum": [
        "pending",
        "sending",
        "sent",
        "failed"
      ],
      "default": "pending",
      "description": "Host alert state: pending, being sent by one worker (sending), accepted for delivery (sent) or failed"
    },
    "notification_attempts": {
      "type": "number",
      "default": 0,
      "description": "How many times the host alert has been attempted"
    },
    "notification_recipient": {
      "type": "string",
      "description": "Address the host alert was sent to"
    },
    "notification_error": {
      "type": "string",
      "description": "Why the last host alert attempt failed"
    },
    "notified_at": {
      "type": "string",
      "description": "When the mail service accepted the host alert"
    },
    "notification_claim_id": {
      "type": "string",
      "description": "The worker that is sending, or last sent, the host alert. Written atomically so two workers cannot both send it"
    },
    "notification_claimed_at": {
      "type": "string",
      "description": "When that worker took the enquiry. Once the lease runs out an unfinished attempt may be taken over"
    },
    "guest_confirmation_status": {
      "type": "string",
      "enum": [
        "pending",
        "sending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending",
      "description": "The guest's own copy of the request, kept separate from the host alert: pending, sending, sent, failed, or skipped when the guest left no address to send it to"
    },
    "guest_confirmation_attempts": {
      "type": "number",
      "default": 0,
      "description": "How many times the guest's copy has been attempted"
    },
    "guest_confirmation_error": {
      "type": "string",
      "description": "Why the last attempt to send the guest their copy failed"
    },
    "guest_confirmation_at": {
      "type": "string",
      "description": "When the mail service accepted the guest's copy"
    },
    "guest_confirmation_claim_id": {
      "type": "string",
      "description": "The worker sending, or last sending, the guest's copy. Written atomically so it is never sent twice"
    },
    "guest_confirmation_claimed_at": {
      "type": "string",
      "description": "When that worker took the guest's copy. Once the lease runs out an unfinished attempt may be taken over"
    },
    "guest_confirmation_sent": {
      "type": "boolean",
      "default": false,
      "description": "True once the guest's own copy of the request has been accepted for delivery, so it is only ever sent once"
    }
  },
  "required": [
    "guest_name",
    "arrival",
    "departure"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}